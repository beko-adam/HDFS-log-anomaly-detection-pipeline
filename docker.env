# Replace these local development credentials before starting.
DJANGO_SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-local-database-password
DJANGO_DEBUG=True
WEB_PORT=8000

# Absolute paths on your Mac. Leave spaces as ordinary characters.
HDFS_MODEL_DIR=/Users/macbook/Desktop/ArabsDev-Projects/Rivyn-task/outputs
HDFS_TEMPLATE_DIR=/Users/macbook/Desktop/ArabsDev-Projects/Rivyn-task/HDFS_v1 (1)/preprocessed
HDFS_LOG_DIR=/Users/macbook/Desktop/ArabsDev-Projects/Rivyn-task/scripting

LOG_PARSE_WORKERS=10
LOG_CHUNK_SIZE=200000
LOG_FEATURE_BATCH_SIZE=300000
LOG_PREDICTION_BATCH_SIZE=300000


POSTGRES_HOST=postgresHost
POSTGRES_PORT=5432
POSTGRES_DB=name_of_your_database
POSTGRES_USER=username_of_your_database_user
POSTGRES_PASSWORD=password_of_your_database_user



